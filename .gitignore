# Local credentials. The newly generated placeholder is intentionally tracked.
.env
.env.*
!/.env.example
.netrc
_netrc
.npmrc
.pypirc
.git-credentials
credentials.json
secrets/
*.pem
*.key

# Environments, build tools and editors
.venv*/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.codex/
.vscode/
.idea/
tools/jdk/
tools/maven/
tools/maven_downloads/
